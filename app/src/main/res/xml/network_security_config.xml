<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext is required for on-device model servers (llama.cpp, Ollama, LM Studio)
  and MCP servers reachable over plain HTTP on localhost / the local network.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
